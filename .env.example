# Relay config. Copy to .env and fill in. .env is gitignored — never commit real values.

# Telegram bot token from @BotFather (https://t.me/BotFather). Free.
TELEGRAM_BOT_TOKEN=

# Free-tier LLM. Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id for the free tier (function-calling capable).
GEMINI_MODEL=gemini-2.0-flash

# anvil-engine (self-hosted browser). Local default; point at your VM when deployed.
ANVIL_BASE_URL=http://localhost:3000
# Only if anvil was started with ANVIL_API_KEY set.
ANVIL_API_KEY=

# Agent safety caps.
RELAY_MAX_STEPS=8
RELAY_RATE_LIMIT_PER_MIN=10
