# Relay config. Copy to .env and fill in. .env is gitignored — never commit real values.

# Telegram bot token from @BotFather (https://t.me/BotFather). Free.
TELEGRAM_BOT_TOKEN=

# Free-tier LLM. Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id for the free tier (function-calling capable). gemini-flash-latest works
# with both classic AIza keys and newer AQ.* keys.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: comma-list failover chain (each model has its own free quota; on a
# 429 the client advances to the next). Defaults to GEMINI_MODEL then flash tiers.
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-2.5-flash-lite

# Agent brain selector (m24). Default gemini (free tier). Set claude to use the Anthropic
# Messages API adapter instead — needs ANTHROPIC_API_KEY (a paid key; live use is owner-gated).
# LLM_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# anvil-engine (self-hosted browser). Local default; point at your VM when deployed.
ANVIL_BASE_URL=http://localhost:3000
# Only if anvil was started with ANVIL_API_KEY set.
ANVIL_API_KEY=

# Optional (m29): path to a gitignored JSON cookie jar so the agent can read pages you're logged
# into. Shape: {"cookies":[{"name","value","domain","path?","secure?"}]}. Cookies are HOST-SCOPED
# (only sent to a matching domain, never cross-origin) and their values are redacted from all logs.
# RELAY_COOKIES=data/relay-cookies.json

# Agent safety caps.
RELAY_MAX_STEPS=8
RELAY_RATE_LIMIT_PER_MIN=10
# Interim "still working…" ping if an errand outlasts this many ms (0 disables). Default 6000.
# RELAY_PROGRESS_DELAY_MS=6000
# Timezone for daily schedules, as minutes EAST of UTC (so "every morning 9am" fires at the user's
# 9am, not the server's). 0 = UTC (default). Examples: US-Eastern EST -300, US-Pacific PST -480, CET +60.
# RELAY_TZ_OFFSET_MIN=0

# Optional tunables (defaults shown; uncomment to override).
# Total anvil attempts per tool call (>=1) before giving up. Default 2.
# ANVIL_RETRY_ATTEMPTS=2
# Interval (ms) for the background anvil keep-alive ping. 0 disables it. Default 60000.
# RELAY_ANVIL_PING_MS=60000
# Where per-chat memory is persisted. Default data/relay-memory.json.
# RELAY_MEMORY_FILE=data/relay-memory.json
# Emit a metrics log line every N turns. Default 50.
# RELAY_METRICS_EVERY=50
# Wall-clock metrics heartbeat: log + snapshot metrics every N ms even with zero agent turns
# (so command-only / idle periods still report). Default 300000 (5 min); <=0 disables.
# RELAY_METRICS_HEARTBEAT_MS=300000
# Where scheduled/proactive tasks are persisted. Default data/relay-schedules.json.
# RELAY_SCHEDULE_FILE=data/relay-schedules.json
# Where saved recipes are persisted. Default data/relay-recipes.json.
# RELAY_RECIPE_FILE=data/relay-recipes.json
# Max proactive (scheduled/recipe) sends per chat per rolling hour — anti-spam. 0 = unlimited. Default 10.
# RELAY_PROACTIVE_MAX_PER_HOUR=10
# How many times a failing one-shot reminder is retried on later ticks before giving up. Default 5.
# RELAY_ONCE_MAX_ATTEMPTS=5
# How long a "once" reminder held back by the hourly proactive cap keeps deferring before it's
# delivered anyway (so an explicit promise can't be starved past its time). Default 900000 (15 min).
# RELAY_ONCE_CAP_GRACE_MS=900000
# Quiet hours (local per-chat tz): hold proactive sends inside [START, END) until END. Hours 0-23.
# Equal/unset = disabled. e.g. START=22 END=7 defers overnight pings to 7am.
# RELAY_QUIET_START=22
# RELAY_QUIET_END=7
# After this many consecutive failures of a recurring watch/digest/schedule, send one "it keeps
# failing" receipt (then reset). Default 3, min 2.
# RELAY_FAIL_STREAK_NOTIFY=3
# For a numeric watch WITHOUT an explicit threshold ("watch bitcoin price"), the minimum move — as a
# percent of the previous value — that counts as a change. Below this, a tick is treated as jitter and
# does not ping (alerts skip quiet hours + the anti-spam cap, so a nonzero-delta rule floods the user).
# Default 0.5 (%). A move off a zero baseline always fires. Set an explicit threshold to override per-alert.
# RELAY_ALERT_DEADBAND_PCT=0.5
# Per-task wall-clock ceiling (ms) for one proactive fire, so a hung anvil/LLM run can't starve other
# chats' due reminders (they run sequentially). A timeout retries a once / advances a recurring. Default
# 90000; set 0 to disable.
# RELAY_FIRE_TIMEOUT_MS=90000
# Max total fires for a sticky "nag me until done" reminder before it gives up on its own (anti-nag),
# even if never acknowledged. Default 8.
# RELAY_STICKY_MAX_FIRES=8
# Where digests (recipe bundles) are persisted. Default data/relay-digests.json.
# RELAY_DIGEST_FILE=data/relay-digests.json
# Max digest member recipes run concurrently — bounds simultaneous anvil browser sessions so a big
# digest can't stampede/exhaust the self-hosted Chrome pool. Default 3.
# RELAY_DIGEST_CONCURRENCY=3
# Max watchlist members checked concurrently — same anvil-pool bound as digests, for a multi-item watch. Default 3.
# RELAY_WATCHLIST_CONCURRENCY=3
# After this many consecutive changed checks, a "watch this page" alert auto-mutes (a dynamic page that
# changes every fetch is a firehose, not a signal). Default 3.
# RELAY_PAGE_FLAP_CAP=3
# Max inbound message handlers run concurrently per getUpdates batch — bounds simultaneous anvil
# browser sessions so a burst of chats can't stampede/exhaust the self-hosted Chrome pool. Default 4.
# RELAY_DISPATCH_CONCURRENCY=4
# Where change-alerts are persisted. Default data/relay-alerts.json.
# RELAY_ALERT_FILE=data/relay-alerts.json
# Where long-term remembered facts ("remember I'm vegetarian") are persisted. Default data/relay-notes.json.
# RELAY_NOTES_FILE=data/relay-notes.json
# Where named lists ("add eggs to my grocery list") are persisted. Default data/relay-lists.json.
# RELAY_LISTS_FILE=data/relay-lists.json
# Where saved contacts ("mom's number is ...") are persisted. Default data/relay-contacts.json.
# RELAY_CONTACTS_FILE=data/relay-contacts.json
# Where saved named places ("my work is ...", "save gym: ...") are persisted. Default data/relay-places.json.
# RELAY_PLACES_FILE=data/relay-places.json
# Where personal quick-log data ("log weight 182", "spent $14 on lunch") is persisted. Default data/relay-logs.json.
# RELAY_LOGS_FILE=data/relay-logs.json
# Where read-it-later saved pages ("save this <link>" -> summary, recalled by "what did I save about X")
# are persisted. Default data/relay-saved.json.
# RELAY_SAVED_FILE=data/relay-saved.json
# How long a saved page can go un-revisited before it counts as "stale-unread" for the "what haven't I
# read" nudge (saved-page-unread-nudge). Default 604800000 (7 days), min 3600000 (1h).
# RELAY_SAVED_STALE_MS=604800000
# How long a shared location pin's coords stay usable (for "near me") before expiring — so a one-time
# pin isn't sent to the LLM forever + near-me doesn't use a stale spot. Default 21600000 (6h), min 60000.
# RELAY_COORDS_TTL_MS=21600000
# Background errands: a large "get back to me" task is ACKed instantly + run in the background with a
# raised step budget, delivered when done. On by default; set to 0 to force every task synchronous.
# RELAY_BACKGROUND_ERRANDS=1
# Where past answers are logged for recall ("what was that place you found?"). Default data/relay-answers.json.
# RELAY_ANSWERS_FILE=data/relay-answers.json
# Where in-flight background errands are tracked so a crash mid-run can recover them. Default data/relay-background.json.
# RELAY_BACKGROUND_FILE=data/relay-background.json
# Default cadence a new alert is checked at. Default "every day at 09:00".
# RELAY_ALERT_CADENCE=every day at 09:00
# USDA FoodData Central key for the nutrition tool ("calories in X"). Optional — the public DEMO_KEY
# works with no signup (rate-limited); set a real key (free at fdc.nal.usda.gov) for a higher quota.
# USDA_API_KEY=DEMO_KEY
# How long after a sticky "nag" reminder last pinged a bare "ok"/"done" still counts as dismissing it (ms).
# Outside this window a bare ack is treated as a normal reply, not a sticky-stop. Default 5400000 (90 min).
# RELAY_STICKY_ACK_WINDOW_MS=5400000
# How often the scheduler checks for due tasks (ms). 0 disables. Default 30000.
# RELAY_SCHED_TICK_MS=30000
# A relative "once" (timer / "remind me in N hours") due within this horizon is exempt from the
# quiet-hours defer — it fires on time instead of being pushed to quiet-end. Default 64800000 (18h).
# RELAY_SHORT_ONCE_MS=64800000
# Which transport to run on: telegram (default) or console (drive the agent from a terminal).
# RELAY_CHANNEL=telegram
