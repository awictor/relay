{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay — text a bot to send an autonomous agent + self-hosted browser (anvil-engine) to fetch and process data from any app. Free-infra MVP.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:live": "tsx scripts/e2e-live.mjs",
    "e2e:faults": "tsx scripts/e2e-faults.mjs",
    "status": "tsx scripts/status.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "puppeteer-core": "^25.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
